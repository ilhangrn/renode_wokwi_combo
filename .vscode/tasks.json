{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C Firmware (ESP32-C3)",
            "type": "shell",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "esp32-c3-devkitm-1"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware-c"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$platformio"
            ],
            "detail": "Build the ESP32-C3 C/Arduino firmware with PlatformIO"
        },
        {
            "label": "Build C Firmware (STM32F103)",
            "type": "shell",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "stm32f103_bluepill"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware-c"
            },
            "group": "build",
            "problemMatcher": [
                "$platformio"
            ],
            "detail": "Build the STM32F103 Blue Pill C/Arduino firmware with PlatformIO"
        },
        {
            "label": "Build Rust Firmware (ESP32-C3)",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--release",
                "--target",
                "riscv32imac-unknown-none-elf",
                "--features",
                "esp32c3",
                "--bin",
                "firmware-rust-esp32c3"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware-rust"
            },
            "group": "build",
            "problemMatcher": [
                "$rustc"
            ],
            "detail": "Build the ESP32-C3 Rust firmware with cargo"
        },
        {
            "label": "Build Rust Firmware (STM32F103)",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--release",
                "--target",
                "thumbv7m-none-eabi",
                "--features",
                "stm32f103",
                "--bin",
                "firmware-rust-stm32f103"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware-rust"
            },
            "group": "build",
            "problemMatcher": [
                "$rustc"
            ],
            "detail": "Build the STM32F103 Blue Pill Rust firmware with cargo"
        },
        {
            "label": "Start Renode Simulation (STM32 C)",
            "type": "shell",
            "command": "renode",
            "args": [
                "blue_pill.resc"
            ],
            "options": {
                "cwd": "${workspaceFolder}/sim/stm32f103_bluepill"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(Error|Fatal):\\s*(.*)$",
                    "severity": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Renode.*",
                    "endsPattern": "^Simulation configured.*|^.*GDB server.*started.*"
                }
            },
            "detail": "Start Renode with the STM32 C firmware and wait for GDB attach"
        },
        {
            "label": "Start Renode Simulation (STM32 Rust)",
            "type": "shell",
            "command": "renode",
            "args": [
                "blue_pill.resc"
            ],
            "options": {
                "cwd": "${workspaceFolder}/sim/stm32f103_bluepill",
                "env": {
                    "RENODE_FW": "rust"
                }
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(Error|Fatal):\\s*(.*)$",
                    "severity": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Renode.*",
                    "endsPattern": "^Simulation configured.*|^.*GDB server.*started.*"
                }
            },
            "detail": "Start Renode with the STM32 Rust firmware and wait for GDB attach"
        },
        {
            "label": "Stop Renode",
            "type": "shell",
            "command": "pkill",
            "args": [
                "-f",
                "renode.*blue_pill.resc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Terminate any running Renode instance started from blue_pill.resc"
        },
        {
            "label": "Test C Host",
            "type": "shell",
            "command": "gcc",
            "args": [
                "${workspaceFolder}/firmware-c/test/desktop_test_sum.c",
                "${workspaceFolder}/firmware-c/src/math/sum.c",
                "-I${workspaceFolder}/firmware-c/src",
                "-o",
                "${workspaceFolder}/firmware-c/test/desktop_test_sum",
                "&&",
                "${workspaceFolder}/firmware-c/test/desktop_test_sum"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware-c"
            },
            "group": "test",
            "problemMatcher": [],
            "detail": "Compile and run host-side C tests for sum"
        },
        {
            "label": "Test C Target (ESP32-C3)",
            "type": "shell",
            "command": "pio",
            "args": [
                "test",
                "-e",
                "esp32-c3-devkitm-1"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware-c"
            },
            "group": "test",
            "problemMatcher": [
                "$platformio"
            ],
            "detail": "Run Unity tests on the ESP32-C3 target"
        },
        {
            "label": "Test C Target (STM32F103)",
            "type": "shell",
            "command": "pio",
            "args": [
                "test",
                "-e",
                "stm32f103_bluepill"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware-c"
            },
            "group": "test",
            "problemMatcher": [
                "$platformio"
            ],
            "detail": "Run Unity tests on the STM32F103 Blue Pill target"
        },
        {
            "label": "Test Rust Host",
            "type": "shell",
            "command": "cargo",
            "args": [
                "test",
                "--lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}/firmware-rust"
            },
            "group": "test",
            "problemMatcher": [
                "$rustc"
            ],
            "detail": "Run host-side Rust tests for sum"
        }
    ]
}