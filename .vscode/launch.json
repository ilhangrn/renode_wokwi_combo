{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C Firmware in Renode",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/firmware-c/.pio/build/esp32-c3-devkitm-1/firmware.elf",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/firmware-c",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/root/.platformio/packages/toolchain-riscv32-esp/bin/riscv32-esp-elf-gdb",
            "miDebuggerServerAddress": "localhost:3333",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set architecture to RISC-V",
                    "text": "set architecture riscv:rv32",
                    "ignoreFailures": true
                },
                {
                    "description": "Start Renode emulation after attach",
                    "text": "monitor start",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Start Renode Simulation (C)",
            "postDebugTask": "Stop Renode"
        },
        {
            "name": "Debug Rust Firmware in Renode",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/firmware-rust/target/riscv32imac-unknown-none-elf/release/firmware-rust",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/firmware-rust",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/root/.platformio/packages/toolchain-riscv32-esp/bin/riscv32-esp-elf-gdb",
            "miDebuggerServerAddress": "localhost:3333",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set architecture to RISC-V",
                    "text": "set architecture riscv:rv32",
                    "ignoreFailures": true
                },
                {
                    "description": "Start Renode emulation after attach",
                    "text": "monitor start",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Start Renode Simulation (Rust)",
            "postDebugTask": "Stop Renode"
        }
    ]
}