{
  "name": "ESP32-C3 + STM32F103 Embedded Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [
    3333
  ],
  "portsAttributes": {
    "3333": {
      "label": "Renode GDB Server",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash -lc 'command -v arm-none-eabi-gdb >/dev/null 2>&1 || ln -sf /usr/bin/gdb-multiarch /usr/local/bin/arm-none-eabi-gdb'",
  "customizations": {
    "vscode": {
      "extensions": [
        "platformio.platformio-ide",
        "rust-lang.rust-analyzer",
        "antmicro.renode",
        "Wokwi.wokwi-vscode"
      ]
    }
  }
}