# 1. Initialize the system bus workspace
using sysbus

# 2. Create the machine instance
mach create "stm32f103_bluepill"

# 3. Load Renode's built-in STM32F103 peripheral description
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl

# Both firmware tracks use the 8 MHz HSI clock; the built-in platform defaults SysTick to 72 MHz.
nvic Frequency 8000000

# 4. Correctly map the Blue Pill's physical onboard LED (PC13)
machine LoadPlatformDescriptionFromString "led: Miscellaneous.LED @ gpioPortC 13"

# 5. Define your absolute or relative firmware path directly
$bin=@../../../firmware-c/.pio/build/stm32f103_bluepill/firmware.elf
# $bin=@../../../firmware-rust/target/thumbv7m-none-eabi/release/firmware-rust-stm32f103

# 6. Parse and load the compiled ELF file to memory
sysbus LoadELF $bin

# 7. Configure vector table base at flash start.
cpu VectorTableOffset 0x08000000
# cpu PC `sysbus ReadDoubleWord 0x08000004`
# cpu SP `sysbus ReadDoubleWord 0x08000000`
#cpu PC `sysbus ReadDoubleWord 0x08000004`
#cpu SP `sysbus ReadDoubleWord 0x08000000`


# 8. Open the Serial Monitor analyzer window (or falling back to console view)
showAnalyzer sysbus.usart1

# 9. Bind a GDB network debugging server (e.g., for VSCode or terminal GDB)
# machine StartGdbServer 3333
# sysbus LogAllPeripheralsAccess false
# logLevel 3 sysbus

# 10. Start the simulation clock
start
