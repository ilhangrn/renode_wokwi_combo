cpu: CPU.RiscV32 @ sysbus
    cpuType: "rv32imac"
    privilegedArchitecture: PrivilegedArchitecture.Priv1_10

flash: Memory.MappedMemory @ sysbus 0x42000000
    size: 0x400000

ram: Memory.MappedMemory @ sysbus 0x3fc80000
    size: 0x60000

uart0: UART.LiteX_UART @ sysbus 0x60000000
    // Simplified UART registers mapped to direct to console logs
