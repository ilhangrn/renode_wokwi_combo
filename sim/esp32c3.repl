sysbus:
    init:
        Tag <0x20000 0x1c0000> "slot0_partition"
        Tag <0x1e0000 0x1c0000> "slot1_partition"
        Tag <0x3b0000 0x30000> "storage_partition"
        Tag <0x3e0000 0x1f000> "scratch_partition"
        Tag <0x0 0x10000> "boot_partition"
        Tag <0x10000 0x10000> "sys_partition"
        Tag <0x3a0000 0x8000> "slot0_lpcore_partition"
        Tag <0x3a8000 0x8000> "slot1_lpcore_partition"
        Tag <0x3ff000 0x1000> "coredump_partition"
        Tag <0x60002000 0x1000> "flash"
        Tag <0x60013000 0x1000> "i2c0"
        Tag <0x60019000 0x1000> "ledc0"
        Tag <0x6001f000 0x1000> "timer0 / wdt0"
        Tag <0x60020000 0x1000> "timer1 / wdt1"
        Tag <0x60024000 0x1000> "spi2"
        Tag <0x6002b000 0x1000> "twai"
        Tag <0x6002d000 0x1000> "i2s"
        Tag <0x6003a000 0x1000> "aes"
        Tag <0x6003f000 0x1000> "dma"
        Tag <0x60004000 0x800> "gpio0"
        Tag <0x60000000 0x400> "uart0"
        Tag <0x60043000 0x400> "usb_serial"
        Tag <0x600c2000 0x198> "intc"
        Tag <0x6003b000 0x100> "sha"
        Tag <0x60023000 0x80> "systimer0"
        Tag <0x60008004 0xc> "rtc_timer / xt_wdt"
        Tag <0x3ff700b0 0x4> "trng0"
        Tag <0x60040000 0x4> "adc0"
        Tag <0x60040058 0x4> "coretemp"

flash0: Memory.MappedMemory @ sysbus 0x0
    size: 0x400000

sram1: Memory.MappedMemory @ sysbus 0x3fc80000
    size: 0x60000

sram0: Memory.MappedMemory @ sysbus 0x4037c000
    size: 0x4000

rtcfastram: Memory.MappedMemory @ sysbus 0x50000000
    size: 0x2000

// autogenerated

cpu0: CPU.RiscV32 @ sysbus
    cpuType: "rv32imc_zicsr_zifencei"
    timeProvider: empty
    hartId: 0
    privilegedArchitecture: PrivilegedArchitecture.Priv1_10

uart1: UART.ESP32_UART @ sysbus 0x60010000