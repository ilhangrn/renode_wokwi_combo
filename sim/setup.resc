mach create "esp32-c3"
machine LoadPlatformDescription @${ORIGIN}/esp32c3.repl

# === TARGET BINARY CONFIGURATION ===
# Choose either C or Rust compiled ELF files:
$bin?=@${ORIGIN}/../firmware-c/.pio/build/esp32-c3-devkitm-1/firmware.elf
# $bin?=@${ORIGIN}/../firmware-rust/target/riscv32imac-unknown-none-elf/debug/firmware-rust

sysbus LoadELF $bin

showAnalyzer uart0
machine StartGdbServer 3333 true
echo "Simulation configured. Attach GDB at localhost:3333, then start emulation from debugger or Renode monitor."
